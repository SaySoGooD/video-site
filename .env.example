# MOCK_DB=True -> in-memory mock DB (no server needed).
# MOCK_DB=False -> PostgreSQL, using the DB_* settings below.
MOCK_DB=True
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=auth_test

JWT_SECRET=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Password hashing scheme: argon2 (recommended) or pbkdf2.
PASSWORD_HASHER=argon2

# Optional Redis cache. Leave REDIS_URL empty to disable (Redis not required).
# Example: redis://localhost:6379/0
REDIS_URL=
AUTH_CACHE_TTL_SECONDS=30

API_HOST=0.0.0.0
API_PORT=8001

API_TITLE=Auth Test API
API_VERSION=0.1.0

SEED_ON_STARTUP=true
