# development | production. "production" refuses to start on any of the unsafe
# defaults below (see infrastructure/config.py).
ENVIRONMENT=development

# PostgreSQL connection.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=users_service

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# Password hashing scheme: argon2 (recommended) or pbkdf2.
PASSWORD_HASHER=argon2

# Redis: the auth cache and the rate limiter. Optional in development (the
# limiter falls back to per-process counters), required in production.
# Example: redis://localhost:6379/0
REDIS_URL=
AUTH_CACHE_TTL_SECONDS=30

# Browser session cookies. Turn COOKIE_AUTH_ENABLED off to return tokens in the
# response body instead (mobile apps, service-to-service).
# COOKIE_SECURE=false is for plain-HTTP local development only.
COOKIE_AUTH_ENABLED=true
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# Share the cookie across subdomains, e.g. .example.com. Empty = host-only.
COOKIE_DOMAIN=

# Double-submit CSRF protection for cookie-authenticated writes.
CSRF_PROTECTION=true

# Long-lived browser id used to join analytics activity to an account.
VISITOR_COOKIE_NAME=visitor_id
VISITOR_COOKIE_MAX_AGE_DAYS=400

# Email. "console" logs the message (development); "smtp" actually sends it.
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@example.com
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Links point at the frontend, not at this API. {token} is substituted.
EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email?token={token}
PASSWORD_RESET_URL=http://localhost:3000/reset-password?token={token}
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30

# Rate limiting. A limit of 0 disables that individual rule.
RATE_LIMIT_ENABLED=true
LOGIN_MAX_ATTEMPTS_PER_IP=30
LOGIN_MAX_ATTEMPTS_PER_ACCOUNT=5
LOGIN_WINDOW_SECONDS=900
REGISTER_MAX_PER_IP=10
REGISTER_WINDOW_SECONDS=3600
FORGOT_PASSWORD_MAX_PER_EMAIL=3
FORGOT_PASSWORD_MAX_PER_IP=10
FORGOT_PASSWORD_WINDOW_SECONDS=3600
RESET_PASSWORD_MAX_PER_IP=10
RESET_PASSWORD_WINDOW_SECONDS=3600

# Role granted to every new signup.
DEFAULT_ROLE_NAME=user

# Frontend origins allowed to send credentialed requests (JSON list).
# Example: ["https://example.com","http://localhost:3000"]
CORS_ORIGINS=[]

# Enable only when a trusted reverse proxy sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false

API_HOST=0.0.0.0
API_PORT=8001
API_TITLE=Users Service API
API_VERSION=0.1.0
API_PREFIX=/api/v1

# Create tables and demo data at startup. Must be false in production —
# Alembic owns the schema there.
SEED_ON_STARTUP=true
